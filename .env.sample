# OPENAI_API_KEY, DB_URL, 모델명 등

# OpenAI
OPENAI_API_KEY=""
EMBED_MODEL=text-embedding-3-large    # 3세대 임베딩(3072차원)

# LLM Models - 각 Agent/Node별 사용 모델
# ============================================
# 생성용 LLM (gpt-5-nano, temperature=1.0)
# - Classify Agent: 질문 의도 분류 및 엔티티 추출
# - Generation Agent: 최종 답변 생성
# - Rewrite Query Node: 쿼리 재작성
GEN_LLM_MODEL=gpt-5-nano
GEN_LLM_TEMPERATURE=1.0

# 평가용 LLM (gpt-5-mini, temperature=1.0)
# - Evaluation Agent: 청크 관련성 평가
# 참고: gpt-5-mini는 temperature=1.0만 지원
EVAL_LLM_MODEL=gpt-5-mini
EVAL_LLM_TEMPERATURE=1.0

OPENAI_TIMEOUT=60

# Tavily (웹 검색)
TAVILY_API_KEY=""                      
# Tavily API 키 (https://tavily.com 에서 발급)

# DB
DB_URL=postgresql://root:root1234@localhost:5432/skn_bank_data
PGVECTOR_INDEX=ivfflat                 # 또는 hnsw
TOP_K=8

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=bank_rag