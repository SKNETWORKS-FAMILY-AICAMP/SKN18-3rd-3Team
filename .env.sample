# OPENAI_API_KEY, DB_URL, 모델명 등

# OpenAI
OPENAI_API_KEY=""
EMBED_MODEL=text-embedding-3-small     # 3세대 임베딩(3072차원) 
# LLM Models
# 생성용 LLM (답변 생성, 분류 등)
GEN_LLM_MODEL=gpt-5-nano
GEN_LLM_TEMPERATURE=1.0
# 평가용 LLM (청크 관련성 평가)
EVAL_LLM_MODEL=gpt-4o
EVAL_LLM_TEMPERATURE=0.0
OPENAI_TIMEOUT=30

# DB
DB_URL=postgresql://root:root1234@localhost:5432/skn_bank_data
PGVECTOR_INDEX=ivfflat                 # 또는 hnsw
TOP_K=8

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=bank_rag